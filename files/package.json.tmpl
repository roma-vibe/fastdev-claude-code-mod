{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Claude Code mod.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build --config ui/vite.config.ts",
    "start": "node ui/server.ts",
    "test": "vitest run",
    "types": "node scripts/types.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.server.json && tsc -p tests/tsconfig.json && vue-tsc --noEmit -p ui/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "validate": "node scripts/validate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run validate"
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
{%- if choices.css == "tailwind" %}
    "@tailwindcss/vite": "4.3.3",
{%- endif %}
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
{%- if choices.css == "tailwind" %}
    "tailwindcss": "4.3.3",
{%- endif %}
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
