@import 'tailwindcss';

/*
 * The page is styled by the component classes below (.page, .card, .btn, …): the
 * components use these names and no utility classes, so the same markup works
 * with plain CSS too. Add new building blocks here.
 */

@layer base {
  html {
    color-scheme: light dark;
  }
  body {
    @apply bg-zinc-50 text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100;
  }
  button:not(:disabled) {
    cursor: pointer;
  }
}

@layer components {
  .page {
    @apply mx-auto max-w-2xl px-4 pb-24;
  }
  .header {
    @apply flex flex-wrap items-center gap-x-4 gap-y-2 py-4;
  }
  .title {
    @apply text-lg font-semibold tracking-tight;
  }
  .stack {
    @apply space-y-4;
  }
  .field {
    @apply space-y-1;
  }
  .row {
    @apply flex flex-wrap gap-2;
  }
  .card {
    @apply rounded-xl border border-zinc-200 bg-white p-4 shadow-xs dark:border-zinc-800 dark:bg-zinc-900;
  }
  .card-title {
    @apply mb-2 text-xs font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-400;
  }
  .btn {
    @apply inline-flex items-center justify-center gap-1.5 rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-800 transition hover:bg-zinc-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:hover:bg-zinc-700;
  }
  .btn-primary {
    @apply border-indigo-600 bg-indigo-600 text-white hover:bg-indigo-500 dark:border-indigo-500 dark:bg-indigo-500 dark:text-white dark:hover:bg-indigo-400;
  }
  .btn-danger {
    @apply border-red-300 bg-white text-red-700 hover:bg-red-50 dark:border-red-900 dark:bg-zinc-800 dark:text-red-400 dark:hover:bg-red-950;
  }
  .input {
    @apply w-full rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm text-zinc-900 placeholder:text-zinc-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 focus:outline-none disabled:opacity-60 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100 dark:placeholder:text-zinc-600;
  }
  .input-narrow {
    @apply max-w-xs;
  }
  .label {
    @apply block text-sm font-medium text-zinc-800 dark:text-zinc-200;
  }
  .help {
    @apply mt-1 text-xs leading-snug text-zinc-500 dark:text-zinc-400;
  }
  .badge {
    @apply inline-flex items-center rounded-full px-2 py-0.5 text-sm font-medium whitespace-nowrap ring-1 ring-inset;
  }
  .badge-gray {
    @apply bg-zinc-100 text-zinc-700 ring-zinc-300 dark:bg-zinc-800 dark:text-zinc-300 dark:ring-zinc-700;
  }
  .badge-green {
    @apply bg-emerald-50 text-emerald-700 ring-emerald-200 dark:bg-emerald-950 dark:text-emerald-300 dark:ring-emerald-800;
  }
  .badge-red {
    @apply bg-red-50 text-red-700 ring-red-200 dark:bg-red-950 dark:text-red-300 dark:ring-red-800;
  }
  .dot {
    @apply mr-1.5 inline-block size-2 rounded-full bg-red-500;
  }
  .dot-on {
    @apply bg-emerald-500;
  }
  .mono {
    @apply font-mono text-xs;
  }
  .sample {
    @apply rounded-lg bg-zinc-100 px-3 py-2 dark:bg-zinc-800;
  }
  .alert {
    @apply mb-4 rounded-lg border border-red-300 bg-red-50 px-4 py-2 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200;
  }
  .toasts {
    @apply pointer-events-none fixed inset-x-0 bottom-0 z-50 flex flex-col items-center gap-2 p-4 sm:items-end;
  }
  .toast {
    @apply pointer-events-auto flex max-w-md items-start gap-3 rounded-lg bg-zinc-900 px-4 py-2.5 text-sm text-white shadow-lg dark:bg-zinc-100 dark:text-zinc-900;
  }
  .toast-error {
    @apply bg-red-600 text-white dark:bg-red-600 dark:text-white;
  }
  .toast-text {
    @apply min-w-0 flex-1 break-words;
  }
  .toast-close {
    @apply opacity-70 hover:opacity-100;
  }
}
