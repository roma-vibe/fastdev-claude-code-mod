/*
 * Plain CSS, no framework. The page is styled by the component classes below
 * (.page, .card, .btn, …) with colours from the variables in :root, which
 * switch to the dark values when the system is dark. Add new building blocks here.
 */

:root {
  color-scheme: light dark;
  --bg: #fafafa;
  --surface: #ffffff;
  --surface-2: #f4f4f5;
  --border: #e4e4e7;
  --border-strong: #d4d4d8;
  --text: #18181b;
  --muted: #71717a;
  --accent: #4f46e5;
  --accent-hover: #6366f1;
  --accent-ring: rgb(79 70 229 / 0.3);
  --danger: #b91c1c;
  --danger-bg: #fef2f2;
  --danger-border: #fca5a5;
  --ok: #047857;
  --ok-bg: #ecfdf5;
  --ok-border: #a7f3d0;
  --toast-bg: #18181b;
  --toast-text: #ffffff;
  --radius: 0.75rem;
  --radius-sm: 0.5rem;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #09090b;
    --surface: #18181b;
    --surface-2: #27272a;
    --border: #27272a;
    --border-strong: #3f3f46;
    --text: #f4f4f5;
    --muted: #a1a1aa;
    --accent: #6366f1;
    --accent-hover: #818cf8;
    --danger: #f87171;
    --danger-bg: #450a0a;
    --danger-border: #7f1d1d;
    --ok: #6ee7b7;
    --ok-bg: #022c22;
    --ok-border: #065f46;
    --toast-bg: #f4f4f5;
    --toast-text: #18181b;
  }
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family:
    system-ui,
    -apple-system,
    'Segoe UI',
    Roboto,
    sans-serif;
  font-size: 1rem;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

h1,
h2,
p {
  margin: 0;
}

button:not(:disabled) {
  cursor: pointer;
}

.page {
  max-width: 42rem;
  margin: 0 auto;
  padding: 0 1rem 6rem;
}
.header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem 1rem;
  padding: 1rem 0;
}
.title {
  font-size: 1.125rem;
  font-weight: 600;
  letter-spacing: -0.01em;
}
.stack > * + * {
  margin-top: 1rem;
}
.field > * + * {
  margin-top: 0.25rem;
}
.row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1rem;
  box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
}
.card-title {
  margin-bottom: 0.5rem;
  color: var(--muted);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  padding: 0.375rem 0.75rem;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--text);
  font: inherit;
  font-size: 0.875rem;
  font-weight: 500;
}
.btn:hover:not(:disabled) {
  background: var(--surface-2);
}
.btn:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}
.btn-primary {
  border-color: var(--accent);
  background: var(--accent);
  color: #ffffff;
}
.btn-primary:hover:not(:disabled) {
  border-color: var(--accent-hover);
  background: var(--accent-hover);
}
.btn-danger {
  border-color: var(--danger-border);
  color: var(--danger);
}
.btn-danger:hover:not(:disabled) {
  background: var(--danger-bg);
}
.input {
  width: 100%;
  padding: 0.375rem 0.75rem;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--text);
  font: inherit;
  font-size: 0.875rem;
}
.input:focus {
  border-color: var(--accent);
  outline: none;
  box-shadow: 0 0 0 3px var(--accent-ring);
}
.input:disabled {
  opacity: 0.6;
}
.input-narrow {
  max-width: 20rem;
}
.label {
  display: block;
  font-size: 0.875rem;
  font-weight: 500;
}
.help {
  margin-top: 0.25rem;
  color: var(--muted);
  font-size: 0.75rem;
  line-height: 1.35;
}
.badge {
  display: inline-flex;
  align-items: center;
  padding: 0.125rem 0.5rem;
  border: 1px solid var(--border-strong);
  border-radius: 999px;
  background: var(--surface-2);
  color: var(--text);
  font: inherit;
  font-size: 0.875rem;
  font-weight: 500;
  white-space: nowrap;
}
.badge-gray {
  color: var(--muted);
}
.badge-green {
  border-color: var(--ok-border);
  background: var(--ok-bg);
  color: var(--ok);
}
.badge-red {
  border-color: var(--danger-border);
  background: var(--danger-bg);
  color: var(--danger);
}
.dot {
  display: inline-block;
  width: 0.5rem;
  height: 0.5rem;
  margin-right: 0.375rem;
  border-radius: 50%;
  background: #ef4444;
}
.dot-on {
  background: #10b981;
}
.mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.75rem;
}
.sample {
  padding: 0.5rem 0.75rem;
  border-radius: var(--radius-sm);
  background: var(--surface-2);
}
.alert {
  margin-bottom: 1rem;
  padding: 0.5rem 1rem;
  border: 1px solid var(--danger-border);
  border-radius: var(--radius-sm);
  background: var(--danger-bg);
  color: var(--danger);
  font-size: 0.875rem;
}
.toasts {
  position: fixed;
  inset: auto 0 0 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.5rem;
  padding: 1rem;
  pointer-events: none;
}
.toast {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  max-width: 28rem;
  padding: 0.625rem 1rem;
  border-radius: var(--radius-sm);
  background: var(--toast-bg);
  color: var(--toast-text);
  font-size: 0.875rem;
  box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.2);
  pointer-events: auto;
}
.toast-error {
  background: #dc2626;
  color: #ffffff;
}
.toast-text {
  min-width: 0;
  flex: 1;
  overflow-wrap: anywhere;
}
.toast-close {
  border: 0;
  background: none;
  color: inherit;
  font: inherit;
  opacity: 0.7;
}
.toast-close:hover {
  opacity: 1;
}
@media (max-width: 40rem) {
  .toasts {
    align-items: center;
  }
}
